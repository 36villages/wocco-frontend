# Copy to Vercel Environment Variables (Production)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ── Dialer (server-only; never prefix with NEXT_PUBLIC_) ───────────────
# Active carriers in priority order; the first is the default. Options: plivo, telnyx, signalwire, voipms
DIALER_PROVIDERS=plivo
# Public URL carriers call back to for "Ring my phone" calls. Falls back to VERCEL_URL.
DIALER_PUBLIC_BASE_URL=
DIALER_SIGNING_SECRET=   # openssl rand -hex 32
DIALER_DEFAULT_AGENT_PHONE=
# Backend endpoint used to check the agent's token before dialing (any authenticated GET)
# DIALER_AUTH_CHECK_PATH=/leads?limit=1

# Plivo (primary)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_IDS=          # comma-separated, e.g. +15551234567
PLIVO_ENDPOINT_USERNAME=
PLIVO_ENDPOINT_PASSWORD=

# Telnyx (secondary — off until listed in DIALER_PROVIDERS)
TELNYX_API_KEY=
TELNYX_TEXML_APP_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=
TELNYX_CALLER_IDS=

# SignalWire (secondary)
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_CALLER_IDS=
SIGNALWIRE_SIP_WSS_URL=
SIGNALWIRE_SIP_URI=
SIGNALWIRE_SIP_PASSWORD=

# VoIP.ms (secondary — browser mode only, needs a WebRTC→SIP gateway)
VOIPMS_WSS_URL=
VOIPMS_SIP_URI=
VOIPMS_SIP_PASSWORD=
VOIPMS_CALLER_IDS=
